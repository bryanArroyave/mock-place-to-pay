{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/rest/gateway/information",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$.instrument.card[?(@.number == '4000000000000101')]"
      }
    ]
  },
  "response": {
    "status": 200,
    "jsonBody": {
      "status": {
        "status": "OK",
        "reason": "",
        "message": "OK"
      },
      "requireOtp": true,
      "credits": [
        {
          "installments": [1, 3, 6, 12]
        }
      ]
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
